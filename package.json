{
  "name": "tracka-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "gen-types": "node scripts/gen-types.mjs",
    "predev": "npm run sync-contract && npm run gen-types",
    "dev": "vite",
    "prebuild": "npm run sync-contract && npm run gen-types",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run sync-contract && npm run gen-types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "ajv": "8.20.0",
    "d3-scale-chromatic": "3.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
